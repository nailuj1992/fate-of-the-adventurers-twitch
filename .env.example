# Copy this file as ".env" and fill it in. NEVER commit .env to a repository.
# Copia este archivo como ".env" y rellénalo. NUNCA subas .env a un repositorio.

# Your Twitch application credentials / Credenciales de tu aplicación: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Channel whose chat is watched (lowercase login). If omitted, the channel of the account that authorizes.
# Canal cuyo chat se vigila (login en minúsculas). Si se omite, el de la cuenta que autorice.
TWITCH_CHANNEL=

# Optional / Opcionales
PORT=3000
# TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# Server console language / Idioma de la consola del servidor: en (default) | es
# LANG_UI=en

# ---- Remote deployment (e.g. Railway) / Despliegue remoto (p. ej. Railway) ----
# Setting PUBLIC_URL turns on remote mode: the panel requires signing in with an allowed Twitch account, and the server listens on 0.0.0.0.
# Definir PUBLIC_URL activa el modo remoto: el panel exige iniciar sesión con una cuenta de Twitch permitida y el servidor escucha en 0.0.0.0.
# PUBLIC_URL=https://your-app.up.railway.app
# Twitch logins allowed to use the panel, comma-separated (default: TWITCH_CHANNEL) / Cuentas permitidas, separadas por comas
# ALLOWED_LOGINS=
# Folder for tokens, settings and history; on Railway, the volume mount path / Carpeta de datos; en Railway, la ruta del volumen
# DATA_DIR=/data
